---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing content: src/content/pages/about.md');
const { Content } = await render(page);
---

<Base title={page.data.title} description="About Saju John Mathew, Bible teacher and missionary.">
	<div class="wrap section" data-pagefind-body>
		<header class="page-head">
			<p class="eyebrow">About</p>
			<h1>{page.data.title}</h1>
		</header>
		<div class="prose">
			<Content />
		</div>
		<p class="next">
			<a class="btn" href="/contact/">Get in touch</a>
		</p>
	</div>
</Base>

<style>
	.next {
		margin-top: 2rem;
	}
</style>
