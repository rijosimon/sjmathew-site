---
import { getCollection } from 'astro:content';
import Icon from '../components/Icon.astro';
import LibraryCard from '../components/LibraryCard.astro';
import MessageCard from '../components/MessageCard.astro';
import Portrait from '../components/Portrait.astro';
import Base from '../layouts/Base.astro';
import { byNewest, LANGUAGE_ORDER, LANGUAGES, SITE } from '../lib/site';

const messages = (await getCollection('messages')).sort(byNewest);
const latest = messages.filter((m) => m.data.kind !== 'article').slice(0, 4);
const reading = messages.filter((m) => m.data.kind === 'article').slice(0, 2);
const library = (await getCollection('library')).sort(byNewest).slice(0, 4);
const tiles = LANGUAGE_ORDER.map((code) => ({
	code,
	...LANGUAGES[code],
	count: messages.filter((m) => m.data.languages.includes(code)).length,
})).filter((tile) => tile.count > 0);
---

<Base>
	<section class="hero wrap">
		<div class="hero-text">
			<p class="eyebrow">Bible teacher · Jesus Mission India</p>
			<h1>{SITE.tagline}</h1>
			<p class="lede">{SITE.intro}</p>
			<form class="home-search" role="search" action="/messages/" method="get">
				<label class="sr-only" for="home-q">Search messages and readings</label>
				<span class="home-search-icon"><Icon name="search" size={18} /></span>
				<input id="home-q" type="search" name="q" placeholder="Search messages" autocomplete="off" enterkeyhint="search" spellcheck="false" />
				<button class="btn" type="submit">Search</button>
			</form>
			<p class="actions">
				<a class="btn secondary" href="/messages/">Browse messages <Icon name="arrow" size={18} /></a>
				<a class="btn secondary" href="/library/">Books &amp; Tracts</a>
			</p>
		</div>
		<Portrait />
	</section>

	<section class="wrap section" aria-labelledby="languages-title">
		<h2 id="languages-title" class="sr-only">Choose a language</h2>
		<ul class="tiles">
			{
				tiles.map((tile) => (
					<li>
						<a class="tile" href={`/messages/?lang=${tile.code}`} style={`--c: var(--lang-${tile.code})`}>
							<span class="native" lang={tile.lang}>
								{tile.native}
							</span>
							<span class="tile-meta">
								{tile.name} · {tile.count} {tile.count === 1 ? 'message' : 'messages'}
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<section class="wrap section" aria-labelledby="latest-title">
		<div class="section-head">
			<h2 id="latest-title">Latest to listen to and watch</h2>
			<a class="more-link" href="/messages/">All messages <Icon name="arrow" size={18} /></a>
		</div>
		<div class="grid">
			{latest.map((message) => <MessageCard message={message} />)}
		</div>
	</section>

	<section class="wrap section" aria-labelledby="read-title">
		<div class="section-head">
			<h2 id="read-title">To read</h2>
			<a class="more-link" href="/messages/?kind=article">All readings <Icon name="arrow" size={18} /></a>
		</div>
		<div class="grid">
			{reading.map((message) => <MessageCard message={message} />)}
		</div>
	</section>

	<section class="wrap section" aria-labelledby="library-title">
		<div class="section-head">
			<h2 id="library-title">E-books and tracts</h2>
			<a class="more-link" href="/library/">Whole library <Icon name="arrow" size={18} /></a>
		</div>
		<div class="grid wide">
			{library.map((item) => <LibraryCard item={item} />)}
		</div>
	</section>
</Base>

<style>
	.hero {
		display: grid;
		align-items: center;
		padding-block: clamp(2.5rem, 1.5rem + 5vw, 5rem) clamp(1rem, 0.5rem + 2vw, 2rem);
	}
	/* Phones and tablets: the small portrait sits between the "Bible teacher" line and the heading.
	   The text block dissolves into the grid so its parts can be ordered around the portrait. */
	@media (max-width: 51.99rem) {
		.hero-text {
			display: contents;
		}
		.hero-text > * {
			order: 3;
		}
		.hero-text > .eyebrow {
			order: 1;
			text-align: center; /* lines up with the centred portrait below it */
		}
		.hero :global(.portrait) {
			order: 2;
			margin-block: 0.25rem 1.25rem;
		}
	}
	@media (min-width: 52rem) {
		.hero {
			grid-template-columns: minmax(0, 1fr) 20rem;
			gap: 3rem;
		}
		.hero :global(.portrait) {
			width: 100%;
			justify-self: end;
		}
	}
	.hero h1 {
		max-width: 22ch;
	}
	.home-search {
		position: relative;
		display: flex;
		gap: 0.5rem;
		max-width: 30rem;
		margin-top: 1.5rem;
	}
	.home-search-icon {
		position: absolute;
		inset-block: 0;
		inset-inline-start: 1rem;
		display: grid;
		place-items: center;
		color: var(--ink-2);
		pointer-events: none;
	}
	.home-search input {
		flex: 1;
		min-width: 0;
		min-height: 2.75rem;
		padding: 0.5rem 1rem 0.5rem 2.75rem;
		font: inherit;
		color: var(--ink);
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 999px;
	}
	.home-search input::placeholder {
		color: var(--ink-2);
	}
	.home-search input:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: 2px;
		border-color: var(--accent);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 1.5rem 0 0;
	}
	.tiles {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.75rem;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
	}
	.tile {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		height: 100%;
		padding: 1rem 1.1rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-inline-start: 5px solid var(--c);
		border-radius: var(--radius);
		color: var(--ink);
		text-decoration: none;
	}
	.tile:hover {
		box-shadow: var(--shadow);
	}
	.native {
		font-family: var(--serif);
		font-size: clamp(1.25rem, 1rem + 1vw, 1.5rem);
		font-weight: 700;
		line-height: 1.4;
	}
	.tile-meta {
		font-size: 0.875rem;
		color: var(--ink-2);
	}
</style>
