---
import { Font } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { PREVIEW, SITE } from '../lib/site';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	/** Language of the page's own text (defaults to English). */
	lang?: string;
}
const { title, description = SITE.description, lang = 'en' } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : SITE.name;
/** One address per page, so search engines do not split it across www, the bare name and the app address. */
const canonical = new URL(Astro.url.pathname, SITE.url).href;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="#fbf8f3" />
		<script is:inline>
			// Runs before the page paints, so there is no flash of the wrong theme.
			(function () {
				var saved = null;
				try {
					saved = localStorage.getItem('sjm-theme');
				} catch (e) {}
				var theme = saved === 'light' || saved === 'dark' ? saved : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				document.documentElement.dataset.theme = theme;
				var meta = document.querySelector('meta[name="theme-color"]');
				if (meta) meta.content = theme === 'dark' ? '#14120f' : '#fbf8f3';
			})();
		</script>
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<link rel="canonical" href={canonical} />
		<meta property="og:url" content={canonical} />
		{PREVIEW && <meta name="robots" content="noindex, nofollow" />}
		<link rel="icon" href="/favicon.ico" sizes="32x32 48x48" />
		<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="alternate" type="application/rss+xml" title="Messages" href="/rss.xml" />
		<Font cssVariable="--font-serif-latin" preload />
		<Font cssVariable="--font-serif-ml" />
		<Font cssVariable="--font-serif-hi" />
		<Font cssVariable="--font-sans-latin" preload />
		<Font cssVariable="--font-sans-ml" />
		<Font cssVariable="--font-sans-hi" />
		<Font cssVariable="--font-serif-ta" />
		<Font cssVariable="--font-sans-ta" />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		{PREVIEW && <div class="preview-banner">Preview of the new site, still being finished. Not the live site.</div>}
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>
