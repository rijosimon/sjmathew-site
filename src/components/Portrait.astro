---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import { SITE } from '../lib/site';

interface Props {
	/** The page's largest picture loads first; use `lazy` for anything lower down. */
	loading?: 'eager' | 'lazy';
}
const { loading = 'eager' } = Astro.props;
---

<figure class="portrait">
	<Image
		src={portrait}
		alt={SITE.name}
		widths={[320, 480, 640]}
		sizes="(min-width: 52rem) 20rem, min(70vw, 18rem)"
		loading={loading}
		fetchpriority={loading === 'eager' ? 'high' : undefined}
		decoding="async"
	/>
</figure>

<style>
	.portrait {
		margin: 0;
		width: min(100%, 18rem);
		border-radius: var(--radius);
		overflow: hidden;
		background: var(--accent-soft);
		box-shadow: var(--shadow);
		outline: 1px solid var(--line);
		outline-offset: -1px;
	}
	.portrait :global(img) {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 3 / 4;
		object-fit: cover;
		object-position: 50% 18%;
	}
</style>
